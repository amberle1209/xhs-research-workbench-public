{
  "manifest_version": 3,
  "name": "XHS Research Workbench",
  "version": "0.1.13",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "小红书研究采集"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://*.xhscdn.com/*"
  ]
}
